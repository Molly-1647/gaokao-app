# Git
.git
.gitignore

# Python 缓存
backend/__pycache__/
*.pyc

# 本地数据库
backend/instance/*.db
backend/instance/*.sqlite3

# 日志
*.log
logs/
data/

# IDE
.idea/
.vscode/

# Node
frontend/node_modules/
# frontend/dist/ 需要包含在构建上下文中（预构建产物）

# 交互原型（不需要入镜像）
交互原型/

# 部署脚本（云服务器版，Render不需要）
deploy/

# 文档
*.md
!backend/requirements.txt

# 环境变量
.env

# Workbuddy
.workbuddy/

# 临时文件
*.tmp
.DS_Store
Thumbs.db
~$*
