# ============================================================
# 环境变量模板 - 复制为 .env 后修改
# 用法: cp .env.example .env
# Docker Compose 会自动读取 .env
# ============================================================

# ----------------------------
# Flask / 后端配置
# ----------------------------
FLASK_ENV=production
FLASK_CONFIG=production

# 密钥 (生产环境必须修改！用以下命令生成: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_secure_string_please

# ----------------------------
# RAG 配置
# ----------------------------
# 1=强制使用TF-IDF离线模式(推荐，无需下载模型，速度快)
# 0=尝试BGE-M3，失败自动降级TF-IDF
FORCE_TFIDF=1

# 向量库目录（容器内路径，请勿修改）
CHROMA_PERSIST_DIR=/app/chroma_db

# ----------------------------
# 数据库配置
# ----------------------------
# SQLite（默认，推荐中小规模）
DATABASE_URL=sqlite:////app/instance/gaokao.db

# 如果云服务器用了单独的 MySQL/PostgreSQL，取消注释修改:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/gaokao
# DATABASE_URL=postgresql://user:password@localhost:5432/gaokao

# ----------------------------
# 时区
# ----------------------------
TZ=Asia/Shanghai

# ----------------------------
# 前端构建时的 API 地址（如前端独立部署则需要）
# ----------------------------
# VITE_API_BASE_URL=/api
